<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>RedfurSync.Core</AssemblyName>
    <RootNamespace>RedfurSync</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI: compiles everywhere, throws PlatformNotSupportedException off Windows.
         Only reached when DeviceToken is non-empty, which never happens in tests. -->
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\AddOn\FissalRelay\FissalRelay.txt" Link="Resources\FissalRelay.txt" />
    <EmbeddedResource Include="..\AddOn\FissalRelay\FissalRelay.lua" Link="Resources\FissalRelay.lua" />
    <EmbeddedResource Include="..\AddOn\FissalRelay\FissalRelay_UI.lua" Link="Resources\FissalRelay_UI.lua" />
    <EmbeddedResource Include="..\AddOn\FissalRelay\FissalRelay_RaffleData.lua" Link="Resources\FissalRelay_RaffleData.lua" />
    <EmbeddedResource Include="..\AddOn\FissalRelay\FissalRelay_RaffleMail.lua" Link="Resources\FissalRelay_RaffleMail.lua" />
    <EmbeddedResource Include="..\AddOn\FissalRelay\FissalRelay_Console.lua" Link="Resources\FissalRelay_Console.lua" />
    <EmbeddedResource Include="..\AddOn\FissalRelay\FissalRelay_MotD.lua" Link="Resources\FissalRelay_MotD.lua" />
    <EmbeddedResource Include="..\AddOn\FissalRelay\FissalRelay_Audit.lua" Link="Resources\FissalRelay_Audit.lua" />
    <EmbeddedResource Include="..\AddOn\FissalRelay\FissalRelay_Bids.lua" Link="Resources\FissalRelay_Bids.lua" />
    <EmbeddedResource Include="..\AddOn\FissalRelay\FissalRelay_Ranks.lua" Link="Resources\FissalRelay_Ranks.lua" />
  </ItemGroup>
</Project>
